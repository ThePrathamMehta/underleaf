# Local Postgres from docker-compose. For a hosted provider that fronts the
# database with a connection pooler (Neon, Supabase), point DATABASE_URL at the
# pooled endpoint and DIRECT_DATABASE_URL at the direct one — Prisma Migrate
# needs a session it can hold a lock on.
DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"
DIRECT_DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"
JWT_SECRET="replace-me-with-a-long-random-string"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Where OAuth providers send their callbacks (defaults to http://localhost:PORT).
# API_ORIGIN="http://localhost:4000"

# --- OAuth (optional) ---
# Each provider activates only when BOTH its id and secret are set. Left blank,
# OAuth stays off and the API boots exactly as before.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- Storage ---
# Where uploaded PDFs and rendered page images are written. Local disk stands in
# for an object store in dev; this is the value an S3/R2 bucket would replace.
# STORAGE_DIR=".storage"
# MAX_UPLOAD_BYTES=15728640
# If you change MAX_UPLOAD_BYTES, set NEXT_PUBLIC_MAX_UPLOAD_BYTES to match in
# apps/web/.env.local — the browser can't read this file, and the two values are
# what keep the instant client-side rejection agreeing with the server's 413.
# Page cap for uploaded PDFs, checked as soon as the document opens. Size alone
# doesn't bound the work a parse does — page count is what tracks the rendering,
# the rows, and the wait the user sits through.
# MAX_PDF_PAGES=30

# --- Admin ---
# Read by the SEED, not by this API — so set it in packages/db/.env, which is
# the .env `bun run db:seed` loads (it runs with that directory as its cwd).
# It is listed here only so this file describes the whole setup in one place.
# Admin gates one thing: which provider and model the deployment's AI features
# call. There is no self-service path to it, because that setting decides what
# every request costs. Listing an email with no account yet is harmless — the
# next seed run after they sign up promotes them.
# ADMIN_EMAILS="you@example.com"

# --- AI providers ---
# Keys live here and ONLY here. The database stores the NAME of one of these
# variables, never a value, and the admin UI picks between names — so no raw key
# is ever written to a row or sent to a browser. A name not on the allowlist in
# src/config.ts is refused, which is what stops an admin from pointing a config
# at JWT_SECRET and reading its presence back.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# Any number of extra keys, for OpenAI-compatible gateways. The AI_KEY_ prefix
# is the allowlist rule — that is the whole reason it exists.
# AI_KEY_TOGETHER=""

# --- Stripe (optional) ---
# Without STRIPE_SECRET_KEY the app boots, /pricing renders, and the free tier
# meters normally; only checkout reports that payments aren't configured. No card
# data ever reaches this API — Checkout and the Customer Portal are both hosted.
# STRIPE_SECRET_KEY="sk_test_..."
#
# Webhook verification is NOT optional when the key is set: an unverified webhook
# is an unauthenticated POST that grants paid access, so a delivery with no secret
# configured to check it against is rejected rather than trusted. In dev, get this
# from `stripe listen --forward-to localhost:4000/billing/webhook`.
# STRIPE_WEBHOOK_SECRET="whsec_..."
#
# The Price ids the paid plans check out against. Test-mode and live-mode ids are
# different strings, which is why they live in the environment and only their
# names live in code (see PLAN_DEFAULTS in @repo/types). Read by the SEED, which
# writes them onto the Plan rows — set them in packages/db/.env too, then re-run
# `bun run db:seed`. A plan with no price id reads as not-purchasable and /pricing
# renders its button disabled rather than failing on click.
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_JOB_SEARCH_PASS="price_..."
