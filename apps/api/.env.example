# Local Postgres from docker-compose. For a hosted provider that fronts the
# database with a connection pooler (Neon, Supabase), point DATABASE_URL at the
# pooled endpoint and DIRECT_DATABASE_URL at the direct one — Prisma Migrate
# needs a session it can hold a lock on.
DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"
DIRECT_DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"
JWT_SECRET="replace-me-with-a-long-random-string"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Where OAuth providers send their callbacks (defaults to http://localhost:PORT).
# API_ORIGIN="http://localhost:4000"

# --- OAuth (optional) ---
# Each provider activates only when BOTH its id and secret are set. Left blank,
# OAuth stays off and the API boots exactly as before.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- Storage ---
# Where uploaded PDFs and rendered page images are written. Local disk stands in
# for an object store in dev; this is the value an S3/R2 bucket would replace.
# STORAGE_DIR=".storage"
# MAX_UPLOAD_BYTES=15728640
