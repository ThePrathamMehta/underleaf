generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable: OAuth-only users never set a password.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  // OAuth identity. Null for password-only accounts. The pair is unique so a
  // provider account maps to exactly one user.
  oauthProvider String?
  oauthId       String?

  resumes Resume[]

  @@unique([oauthProvider, oauthId])
}

model Template {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String
  previewImageUrl String?
  category        String
  /// Reserved for a later paid tier; unused in v1.
  isPremium       Boolean @default(false)
  /// Theme JSON, validated against themeSchema in @repo/types.
  defaultTheme    Json
  /// Sample content shown in the gallery and copied into new resumes.
  sampleContent   Json

  resumes     Resume[]
  professions TemplateProfession[]

  @@index([category])
}

/// Who a template is *for*, as opposed to what it looks like.
///
/// Deliberately orthogonal to `Template.category`: category is a style
/// descriptor (Minimal, Creative), profession is an audience descriptor. A
/// Lawyer and an Academic may both be well served by the same conservative
/// serif layout, so collapsing the two would lose one axis or the other.
model Profession {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  /// Key into the icon set in @repo/ui — not an emoji, per the v1 design rules.
  iconKey     String
  /// Display order in the gallery's profession row.
  sortOrder   Int    @default(0)

  templates TemplateProfession[]

  @@index([sortOrder])
}

/// Curated many-to-many: a template can be among the best picks for several
/// professions, which is what makes 5–7 per profession reachable without an
/// equal number of bespoke layouts.
model TemplateProfession {
  templateId   String
  professionId String
  /// Order within this profession's list; 0 is the strongest recommendation.
  rank         Int    @default(0)

  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([templateId, professionId])
  @@index([professionId, rank])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  title      String
  /// ResumeContent JSON, validated against resumeContentSchema in @repo/types.
  content    Json
  /// Theme JSON — the user's overrides of the template's defaultTheme.
  theme      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  @@index([userId, updatedAt])
}
