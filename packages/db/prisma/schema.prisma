generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations run against the un-pooled endpoint. Prisma Migrate takes a
  // session-scoped advisory lock, which a transaction-pooling PgBouncer in
  // front of the pooled URL can't keep across statements.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable: OAuth-only users never set a password.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  /// `user` or `admin`. v1–v3 had no role concept; v4 introduces one solely to
  /// gate the AI provider settings, which are an org-wide deployment concern
  /// rather than a per-user preference.
  ///
  /// A String rather than an enum to keep migrations cheap: adding a role later
  /// shouldn't require an ALTER TYPE, and the set of values is validated in
  /// @repo/types where every other domain value already is.
  role String @default("user")

  // OAuth identity. Null for password-only accounts. The pair is unique so a
  // provider account maps to exactly one user.
  oauthProvider String?
  oauthId       String?

  resumes   Resume[]
  pdfs      PdfDocument[]
  aiUsage   AiUsageLog[]
  chats     ChatSession[]
  coverLetters CoverLetter[]

  subscriptions Subscription[]
  aiAllowance   UserAiUsage[]

  @@unique([oauthProvider, oauthId])
}

model Template {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String
  previewImageUrl String?
  category        String
  /// Reserved for a later paid tier; unused in v1.
  isPremium       Boolean @default(false)
  /// Theme JSON, validated against themeSchema in @repo/types.
  defaultTheme    Json
  /// Sample content shown in the gallery and copied into new resumes.
  sampleContent   Json

  resumes     Resume[]
  professions TemplateProfession[]

  @@index([category])
}

/// Who a template is *for*, as opposed to what it looks like.
///
/// Deliberately orthogonal to `Template.category`: category is a style
/// descriptor (Minimal, Creative), profession is an audience descriptor. A
/// Lawyer and an Academic may both be well served by the same conservative
/// serif layout, so collapsing the two would lose one axis or the other.
model Profession {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  /// Key into the icon set in @repo/ui — not an emoji, per the v1 design rules.
  iconKey     String
  /// Display order in the gallery's profession row.
  sortOrder   Int    @default(0)
  /// A sample resume written for *this* profession — a CA's articleship and
  /// audit engagements, a lawyer's bar admissions and matters — validated
  /// against resumeContentSchema in @repo/types.
  ///
  /// Lives here rather than on Template because the two are many-to-many: the
  /// Classic layout is a curated pick for six professions, so one document per
  /// template could only ever show one profession's career. The gallery
  /// substitutes this when a profession filter is active and falls back to the
  /// template's own sample otherwise.
  ///
  /// Nullable so a profession seeded without one still renders — it just shows
  /// the template's general sample.
  sampleContent Json?

  templates TemplateProfession[]

  @@index([sortOrder])
}

/// Curated many-to-many: a template can be among the best picks for several
/// professions, which is what makes 5–7 per profession reachable without an
/// equal number of bespoke layouts.
model TemplateProfession {
  templateId   String
  professionId String
  /// Order within this profession's list; 0 is the strongest recommendation.
  rank         Int    @default(0)

  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([templateId, professionId])
  @@index([professionId, rank])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  title      String
  /// ResumeContent JSON, validated against resumeContentSchema in @repo/types.
  content    Json
  /// Theme JSON — the user's overrides of the template's defaultTheme.
  theme      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id])

  chats         ChatSession[]
  atsScores     AtsScoreResult[]
  jdComparisons JdComparison[]
  coverLetters  CoverLetter[]

  @@index([userId, updatedAt])
}

// --- Uploaded PDFs ---
//
// Deliberately a separate model family from Resume. A Resume is structured
// content we render; an uploaded PDF is somebody else's fixed layout that we can
// only retype in place. Forcing the two through one model would mean a `content`
// JSON that means something different depending on a type flag — and every
// consumer branching on it.

/// One uploaded PDF, parsed once at upload into pages and text runs.
model PdfDocument {
  id     String @id @default(cuid())
  userId String
  /// Storage key for the original upload — never a public URL. The bytes are
  /// served through an ownership-checked route, and export re-reads them so the
  /// non-text content of the source is preserved exactly.
  ///
  /// Named ...Url to match the field name in the spec; it holds a key.
  originalFileUrl String
  pageCount       Int
  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages PdfPage[]

  @@index([userId, updatedAt])
}

/// A single page: its PDF-space dimensions and its rasterized backdrop.
model PdfPage {
  id            String @id @default(cuid())
  pdfDocumentId String
  /// Zero-based, matching the array index the editor navigates by.
  pageIndex     Int
  /// Page size in PDF points at scale 1, so overlay coordinates and export
  /// coordinates share one space regardless of the raster's resolution.
  width         Float
  height        Float
  /// Storage key for the rendered page image — the editor's canvas backdrop,
  /// carrying every non-text element (rules, logos, graphics).
  backgroundImageUrl String
  /// Content hash of those image bytes, carried in the image URL as a query
  /// param. Page images are immutable-cached by the browser, so re-parsing a
  /// document has to change the URL or the editor keeps showing the old backdrop.
  backgroundVersion  String

  document PdfDocument  @relation(fields: [pdfDocumentId], references: [id], onDelete: Cascade)
  runs     PdfTextRun[]

  @@unique([pdfDocumentId, pageIndex])
}

/// One fixed-position block of text, editable in place.
///
/// `originalText` is kept alongside `text` so an edit is always a diff against
/// the source: we know exactly which runs to redact at export time, and an
/// export that fails on a run can fall back to what the PDF already says.
model PdfTextRun {
  id        String @id @default(cuid())
  pdfPageId String

  /// Bounding box in PDF points, top-left origin (the browser's convention).
  /// Converted back to PDF's bottom-left origin at export.
  x      Float
  y      Float
  width  Float
  height Float

  /// Distance from the top of the box down to the text baseline, in points.
  ///
  /// Stored rather than derived because it can't be recovered from the box. The
  /// parser builds the box from the font's own ascent and descent
  /// (`height = (ascent + |descent|) * fontSize`), so `height` is a single
  /// equation in two unknowns — export would have to guess a descent ratio, and
  /// a wrong guess drops redrawn text off the baseline its unedited neighbours
  /// sit on. Keeping the value the parser already computed makes the export's
  /// inversion exact.
  baseline Float

  /// CSS font stack to render this run with in the editor.
  fontFamily String
  /// Which tier of B.2.3's font resolution produced `fontFamily`:
  /// `embedded` (the PDF's own font file), `standard` (a base-14 font mapped to
  /// its web equivalent), or `fallback` (best-effort by name). Only `fallback`
  /// is shown to the user as inexact.
  ///
  /// The spec calls this `fontSizeSource`; that reads as a typo, since its
  /// values describe the font and `fontSize` is a separate field.
  fontSource String
  /// Storage key for the extracted embedded font program, when `fontSource` is
  /// `embedded`. Null otherwise.
  embeddedFontUrl String?
  fontSize        Float
  /// Glyph colour, `#rrggbb`.
  color           String
  /// Local background behind this run, `#rrggbb` — sampled at parse time and
  /// used both to hide the original glyphs in the editor backdrop and to paint
  /// the redaction rectangle at export, so the two can't disagree.
  backgroundColor String

  originalText String
  text         String
  updatedAt    DateTime @updatedAt

  page PdfPage @relation(fields: [pdfPageId], references: [id], onDelete: Cascade)

  @@index([pdfPageId])
}

// --- AI (v4) ---

/// Which provider and model answer a given kind of request.
///
/// Scoped by `purpose` rather than being a single global setting, because the
/// four v4 features have genuinely different cost profiles: the chat assistant
/// justifies a strong model, ATS scoring runs often enough that a cheap one is
/// the right call. One row per purpose lets an admin make that trade without
/// forcing the same choice everywhere.
model AiProviderConfig {
  id String @id @default(cuid())
  /// `openai` | `anthropic` | `other`. `other` speaks the OpenAI chat
  /// completions format against a configurable base URL, which is what makes
  /// self-hosted gateways reachable without an adapter each.
  provider  String
  modelName String
  /// The NAME of an environment variable holding the key — never a key.
  ///
  /// This is the load-bearing half of "no raw API key in the database". The name
  /// is resolved at call time through an allowlist in the API's config, so an
  /// admin cannot point this at JWT_SECRET and read it back through the config
  /// endpoint. See `resolveSecretRef` in apps/api/src/config.ts.
  apiKeySecretRef String
  /// `chat` | `ats` | `jdMatch` | `coverLetter` | `latexImport` | `all`. `all` is
  /// the fallback used when no row targets a purpose specifically.
  purpose String
  /// Which membership tier this row serves: `free` | `pro_monthly` |
  /// `job_search_pass`, or null for "any plan" (v5 Section 4).
  ///
  /// Exists so free-tier chat can be routed to a cheaper model than paid-tier
  /// chat without changing a line of calling code — the tier that doesn't pay is
  /// also the tier whose allowance we give away, and this is what makes giving it
  /// away cheaper. Null is the fallback, matching how `all` works for `purpose`:
  /// a deployment that never sets it behaves exactly as it did in v4.
  planKey String?
  /// Only one row per purpose should be active; the registry takes the most
  /// recently updated active row, so flipping this is how an admin switches
  /// models without a redeploy.
  isActive  Boolean  @default(true)
  /// Optional override for `other`, and for pointing a first-party provider at
  /// a proxy. Null means the provider's own default endpoint.
  baseUrl   String?
  updatedAt DateTime @updatedAt

  @@index([purpose, isActive, updatedAt])
  @@index([planKey, purpose, isActive, updatedAt])
}

/// One row per provider call, for cost tracking.
///
/// Records what a call cost, never what it said: no prompt, no completion, no
/// resume content. A usage table is the wrong place to accumulate a copy of
/// every document a user has ever edited, and keeping it metadata-only means it
/// needs no special handling on account deletion beyond the cascade.
model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  provider     String
  modelName    String
  purpose      String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  /// Round-trip wall time in milliseconds, including retries.
  latencyMs    Int
  /// Null on success; otherwise the AiError code that ended the call, so a
  /// spike in failures is visible without correlating against server logs.
  errorCode    String?
  createdAt    DateTime @default(now())

  /// Nullable and SetNull rather than Cascade: deleting an account shouldn't
  /// silently rewrite the spend history the log exists to record.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

// --- Feature 1: chat assistant ---

/// One conversation about one resume.
///
/// Unique on `resumeId`: the editor shows a single thread per document, and
/// `GET /resumes/:id/chat` restores "the" conversation on reopen. Allowing
/// several would mean a session picker nobody asked for, and the model has no
/// way to choose between them.
model ChatSession {
  id        String   @id @default(cuid())
  resumeId  String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume   Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

/// One turn in a conversation.
///
/// `toolCalls` records what the assistant *asked* to change, not the resulting
/// document: the resume itself is the source of truth for its own content, and
/// storing a second copy per turn would let the two disagree after an undo.
model ChatMessage {
  id        String @id @default(cuid())
  sessionId String
  /// `user` | `assistant` | `system`.
  role      String
  content   String
  /// Array of `{ name, arguments, ok, error? }` — null for plain replies.
  toolCalls Json?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// --- Feature 2: ATS scoring ---

/// One scoring run, kept rather than overwritten.
///
/// History is the feature, not a side effect: a score is only motivating if the
/// user can watch it move after they act on an issue, and a single mutable row
/// would make "it went from 61 to 78" unrepresentable.
model AtsScoreResult {
  id       String @id @default(cuid())
  resumeId String
  /// 0–100.
  overallScore Int
  /// `{ keywords, formatting, impact, completeness }`, each 0–100.
  categoryScores Json
  /// Array of `{ id, severity, category, message, fix, sectionRef }`.
  /// `sectionRef` is a section id in the resume's own content, which is what
  /// makes an issue clickable rather than generic advice.
  issues Json
  /// Whether the AI half of the hybrid actually ran. False means the provider
  /// was unreachable and this is the rule-based score alone — surfaced in the
  /// panel, because silently scoring on half the checks would be misleading.
  aiAssisted Boolean @default(false)
  createdAt  DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

// --- Feature 3: JD match ---

model JdComparison {
  id       String @id @default(cuid())
  resumeId String
  jobDescriptionText String
  /// 0–100.
  matchScore Int
  /// Arrays of `{ term, weight, evidence? }`.
  matchedKeywords Json
  missingKeywords Json
  /// Array of `{ id, message, sectionRef, instruction }`. `instruction` is the
  /// text handed to the chat assistant by "Apply with AI", written server-side
  /// so the hand-off can't be steered from the browser.
  suggestions Json
  createdAt   DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
}

// --- Feature 4: cover letters ---

/// A generated, then hand-editable, letter.
///
/// Carries `userId` as well as `resumeId` because `PATCH /cover-letters/:id` and
/// the export route are addressed by letter id rather than nested under the
/// resume — without it, every one of those would need a join to answer "is this
/// yours", and the ownership filter belongs in the WHERE clause.
model CoverLetter {
  id       String @id @default(cuid())
  resumeId String
  userId   String
  /// The JD it was tailored to, if any. Copied rather than referenced, so
  /// deleting a JdComparison doesn't strand a letter with no context.
  jobDescriptionText String?
  /// The letter body as plain text with blank-line paragraph breaks. Not the
  /// block-editor's structured content: a letter is prose, and the spec is
  /// explicit that it shouldn't inherit that infrastructure.
  content String
  /// `formal` | `friendly` | `concise`.
  tone      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([resumeId, updatedAt])
}

// --- Membership and billing (v5) ---
//
// The line these three models draw is the one the codebase already drew: a
// feature that costs nothing to run is free and unmetered, a feature that spends
// tokens is metered. Nothing here gates resume editing, PDF work, export, the
// rule-based ATS score, or the deterministic JD keyword diff.

/// A purchasable tier.
///
/// A table rather than a hardcoded constant because `stripePriceId` differs per
/// environment — test-mode and live-mode price ids are not the same string — and
/// baking that into the bundle would mean a redeploy to change a price. The
/// *shape* of a plan is code (`PLAN_KEYS` in @repo/types); its price and
/// allowance are data, which is what Section 0 asks for when it says these
/// numbers should be tuned from `AiUsageLog` rather than guessed once.
model Plan {
  id String @id @default(cuid())
  /// `free` | `pro_monthly` | `job_search_pass`. Unique: this is the stable
  /// identifier every lookup and every seed run keys on, not the cuid.
  key  String @unique
  name String
  /// Integer cents, never a float. 0 for free.
  priceCents Int
  /// `month` for the renewing plan, `one_time` for the pass, null for free.
  billingInterval String?
  /// Fixed lifetime in days. Set only for `job_search_pass`, which expires by
  /// date regardless of unused allowance; null means "does not expire by date".
  durationDays Int?
  /// Metered AI actions this plan grants per period — or once, for the free
  /// plan and the pass, neither of which refills.
  aiActionAllowance Int
  /// True only for `pro_monthly`. Distinguishes "Stripe will bill this again"
  /// from "this was paid once", which is what decides whether a renewal webhook
  /// should open a fresh usage period or be ignored.
  isRenewing Boolean @default(false)
  /// The Stripe Price this plan checks out against. Null for free, which is
  /// never purchased. Nullable rather than required so the app boots and the
  /// free tier works fully before any Stripe account exists.
  stripePriceId String?
  /// Display order on /pricing, cheapest first.
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([sortOrder])
}

/// A user's membership in a plan.
///
/// Every user has exactly one `active` row, including free users: an explicit
/// free-plan row created at signup means `getActivePlan` is one indexed read
/// with no "no subscription found" branch, and no code path where the absence of
/// a row has to be interpreted.
model Subscription {
  id     String @id @default(cuid())
  userId String
  planId String
  /// `active` | `canceled` | `expired` | `past_due`.
  ///
  /// `canceled` still grants access until `currentPeriodEnd` — Stripe's
  /// cancel-at-period-end sets the intent immediately while the paid period runs
  /// on, and taking access away at the click would be charging for time we then
  /// refused to serve.
  status String @default("active")
  startedAt DateTime @default(now())
  /// When access lapses. Null for free, which never expires. For the pass this
  /// is `startedAt + durationDays`; for Pro Monthly it tracks Stripe's period.
  currentPeriodEnd DateTime?
  /// Set when the user asked to cancel but the paid period hasn't run out.
  cancelAtPeriodEnd Boolean @default(false)
  /// Null for free and for one-time purchases, which create no Stripe
  /// subscription object.
  stripeSubscriptionId String? @unique
  /// The Stripe Customer. Retained across plan changes so a returning buyer
  /// keeps one customer record and one payment-method list in the portal.
  stripeCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  usagePeriods UserAiUsage[]

  /// The lookup every metered request makes.
  @@index([userId, status, createdAt])
  @@index([stripeCustomerId])

  /// Also carries a partial unique index that Prisma's schema language can't
  /// express, added in `20260811140000_one_active_subscription_per_plan`:
  ///
  ///   UNIQUE ("userId", "planId") WHERE status = 'active'
  ///
  /// It's what makes `ensureFreeSubscription` idempotent under a
  /// double-submitted signup. If a future `prisma migrate dev` offers to drop
  /// it as drift, keep it and re-apply.
}

/// One grant of metered AI actions, and how much of it has been spent.
///
/// A new row per period rather than a counter reset in place: overwriting would
/// destroy exactly the per-period history Section 0 says the allowance numbers
/// should eventually be tuned from, and it makes a replayed renewal webhook
/// indistinguishable from a real one.
///
/// `allowanceConsumed` is the only hot-write column in the schema. It is
/// incremented under a row lock inside a transaction — see
/// `checkAndConsumeAiAction` — because the read-decide-write around it is
/// exactly the shape that double-spends the last action when two requests race.
model UserAiUsage {
  id             String @id @default(cuid())
  userId         String
  subscriptionId String
  allowanceGranted  Int
  allowanceConsumed Int @default(0)
  periodStart DateTime @default(now())
  /// When this grant stops counting. Null for the free plan's one-time grant,
  /// which never refills and never lapses — a free user who spent 3 of 10
  /// actions a year ago still has 7.
  periodEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Resolving "the current grant" is newest-first per user.
  @@index([userId, createdAt])
  @@index([subscriptionId])
}

/// Stripe event ids that have already been processed.
///
/// Stripe retries a webhook until it gets a 2xx, and it can deliver the same
/// event more than once even after one. Both are normal, and both are dangerous
/// here: a replayed `invoice.paid` would write a second UserAiUsage row and hand
/// out a second month of actions for one payment.
///
/// So the id is inserted *before* the event is handled, and a conflict on this
/// primary key is the signal to skip. Being keyed on Stripe's own event id makes
/// this work for every event type at once, which a unique column on Subscription
/// would not — renewals never create a subscription row to conflict on.
model StripeEvent {
  /// Stripe's event id, e.g. `evt_1P...`.
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  /// Lets an operator prune events older than Stripe's own retention window.
  @@index([receivedAt])
}
