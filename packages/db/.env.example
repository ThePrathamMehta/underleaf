# Prisma reads both from here. With a pooled provider (Neon, Supabase) the two
# differ: DATABASE_URL is the pooled endpoint the app queries, and
# DIRECT_DATABASE_URL is the direct one Prisma Migrate needs. Against a plain
# local Postgres they're the same string.
DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"
DIRECT_DATABASE_URL="postgresql://underleaf:underleaf@localhost:5442/underleaf?schema=public"

# Comma-separated emails promoted to admin by `bun run db:seed`. It belongs here
# rather than only in apps/api/.env because the seed runs with this directory as
# its cwd, so this is the .env it actually reads. The API needs no copy — it
# reads the role from the database, not from the environment. Only ever
# promotes, never demotes; naming an email with no account yet is harmless.
# ADMIN_EMAILS="you@example.com"
