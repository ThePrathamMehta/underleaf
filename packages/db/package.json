{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./samples": "./src/samples/index.ts",
    "./sample-content": "./src/sample-content.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:neon": "bun run scripts/migrate-ws.ts",
    "db:push": "prisma db push",
    "db:seed": "bun run src/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "^6.2.1",
    "@repo/types": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "prisma": "^6.2.1",
    "typescript": "5.9.2"
  }
}
